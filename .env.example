# Üretimde gerçek domain'i yazın (örn: https://santiye360.org)
NEXTAUTH_URL="http://localhost:3000"

# Opsiyonel: AI Analytics ve sesli asistan özellikleri için
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
