# PostgreSQL bağlantı adresi
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/santiye360?schema=public"

# NextAuth.js (Auth.js) oturum imzalama anahtarı — üretmek için: openssl rand -base64 32
AUTH_SECRET=""
