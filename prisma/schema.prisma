// ─── SÖZLEŞMELER ─────────────────────────────────────────
model Contract {
  id           String         @id @default(cuid())
  employeeId   String         @map("employee_id")
  type         ContractType
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  salary       Float          @default(0)
  notes        String?
  status       ContractStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

enum ContractType {
  INDEFINITE
  FIXED_TERM
  PART_TIME
  TRIAL
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

// ─── EVRAKLAR ────────────────────────────────────────────
model EmployeeDocument {
  id           String       @id @default(cuid())
  employeeId   String       @map("employee_id")
  type         DocumentType
  name         String
  fileUrl      String?      @map("file_url")
  expiryDate   DateTime?    @map("expiry_date") @db.Date
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

enum DocumentType {
  KIMLIK
  DIPLOMA
  SAGLIK_RAPORU
  ADLI_SICIL
  IKAMETGAH
  SGK_BILDIRGE
  SOZLESME
  EHLIYET
  SERTIFIKA
  DIGER
}

// ─── İZİN TALEPLERİ ─────────────────────────────────────
model LeaveRequest {
  id            String        @id @default(cuid())
  employeeId    String        @map("employee_id")
  type          LeaveType
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  totalDays     Float         @map("total_days")
  reason        String?
  status        RequestStatus @default(PENDING)
  approvedBy    String?       @map("approved_by")
  approvedAt    DateTime?     @map("approved_at")
  rejectionNote String?       @map("rejection_note")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  MARRIAGE
  BEREAVEMENT
  UNPAID
  COMPENSATION
  OTHER_LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ─── İZİN BAKİYELERİ ────────────────────────────────────
model LeaveBalance {
  id            String   @id @default(cuid())
  employeeId    String   @map("employee_id")
  year          Int
  totalDays     Float    @default(14) @map("total_days")
  usedDays      Float    @default(0)  @map("used_days")
  remainingDays Float    @default(14) @map("remaining_days")

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("leave_balances")
}

// ─── DİSİPLİN KAYITLARI ─────────────────────────────────
model DisciplineRecord {
  id           String         @id @default(cuid())
  employeeId   String         @map("employee_id")
  type         DisciplineType
  date         DateTime       @db.Date
  description  String
  action       String?
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("discipline_records")
}

enum DisciplineType {
  VERBAL_WARNING
  WRITTEN_WARNING
  SUSPENSION
  FINE
  TERMINATION_NOTICE
}

// ─── PERFORMANS DEĞERLENDİRME ───────────────────────────
model PerformanceReview {
  id           String       @id @default(cuid())
  employeeId   String       @map("employee_id")
  period       String
  reviewerId   String?      @map("reviewer_id")
  score        Float?       @default(0)
  notes        String?
  status       ReviewStatus @default(DRAFT)
  reviewDate   DateTime?    @map("review_date") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("performance_reviews")
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  COMPLETED
}

// ─── POZİSYON GEÇMİŞİ ──────────────────────────────────
model PositionHistory {
  id             String             @id @default(cuid())
  employeeId     String             @map("employee_id")
  changeType     PositionChangeType @map("change_type")
  fromPosition   String?            @map("from_position")
  toPosition     String             @map("to_position")
  fromDepartment String?            @map("from_department")
  toDepartment   String?            @map("to_department")
  fromSalary     Float?             @map("from_salary")
  toSalary       Float?             @map("to_salary")
  effectiveDate  DateTime           @map("effective_date") @db.Date
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("position_history")
}

enum PositionChangeType {
  HIRE
  PROMOTION
  DEMOTION
  TRANSFER
  SALARY_CHANGE
  DEPARTMENT_CHANGE
}

// ═══════════════════════════════════════════════════════════
// İSG MODÜLÜ
