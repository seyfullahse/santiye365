// ─── EĞİTİM TANIMLARI ───────────────────────────────────
model TrainingDefinition {
  id              String           @id @default(cuid())
  name            String
  description     String?
  durationHours   Float            @default(0) @map("duration_hours")
  isMandatory     Boolean          @default(false) @map("is_mandatory")
  validityMonths  Int?             @map("validity_months")
  category        TrainingCategory @default(ISG)
  createdAt       DateTime         @default(now()) @map("created_at")

  trainings       EmployeeTraining[]

  @@map("training_definitions")
}

enum TrainingCategory {
  ISG
  TECHNICAL
  PROFESSIONAL
  ORIENTATION
}

// ─── ÇALIŞAN EĞİTİMLERİ ─────────────────────────────────
model EmployeeTraining {
  id                String         @id @default(cuid())
  employeeId        String         @map("employee_id")
  trainingId        String         @map("training_id")
  trainingDate      DateTime       @map("training_date") @db.Date
  expiryDate        DateTime?      @map("expiry_date") @db.Date
  status            TrainingStatus @default(PLANNED)
  score             Float?
  certificateUrl    String?        @map("certificate_url")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")

  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  training          TrainingDefinition @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@map("employee_trainings")
}

enum TrainingStatus {
  PLANNED
  COMPLETED_TRAINING
  FAILED
  EXPIRED_TRAINING
}

// ─── SERTİFİKALAR ───────────────────────────────────────
model Certificate {
  id           String            @id @default(cuid())
  employeeId   String            @map("employee_id")
  name         String
  issuedBy     String?           @map("issued_by")
  issueDate    DateTime          @map("issue_date") @db.Date
  expiryDate   DateTime?         @map("expiry_date") @db.Date
  fileUrl      String?           @map("file_url")
  status       CertificateStatus @default(VALID)
  createdAt    DateTime          @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

enum CertificateStatus {
  VALID
  EXPIRED_CERT
  REVOKED
}

// ─── PERİYODİK MUAYENE ──────────────────────────────────
model MedicalExam {
  id           String     @id @default(cuid())
  employeeId   String     @map("employee_id")
  type         ExamType
  examDate     DateTime   @map("exam_date") @db.Date
  nextExamDate DateTime?  @map("next_exam_date") @db.Date
  result       ExamResult @default(PENDING_EXAM)
  hospital     String?
  doctorName   String?    @map("doctor_name")
  fileUrl      String?    @map("file_url")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("medical_exams")
}

enum ExamType {
  ENTRY
  PERIODIC
  EXIT_EXAM
  RETURN
}

enum ExamResult {
  PENDING_EXAM
  FIT
  CONDITIONAL
  UNFIT
}

// ─── KKD TÜRLERİ ────────────────────────────────────────
model PPEType {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String?
  validityDays Int?     @map("validity_days")
  createdAt    DateTime @default(now()) @map("created_at")

  assignments  PPEAssignment[]

  @@map("ppe_types")
}

// ─── KKD ZİMMET ──────────────────────────────────────────
model PPEAssignment {
  id           String    @id @default(cuid())
  employeeId   String    @map("employee_id")
  ppeTypeId    String    @map("ppe_type_id")
  assignDate   DateTime  @map("assign_date") @db.Date
  returnDate   DateTime? @map("return_date") @db.Date
  expiryDate   DateTime? @map("expiry_date") @db.Date
  serialNo     String?   @map("serial_no")
  status       PPEStatus @default(ASSIGNED)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ppeType      PPEType  @relation(fields: [ppeTypeId], references: [id], onDelete: Cascade)

  @@map("ppe_assignments")
}

enum PPEStatus {
  ASSIGNED
  RETURNED
  LOST
  DAMAGED
  EXPIRED_PPE
}

// ─── İŞ KAZALARI ─────────────────────────────────────────
model WorkAccident {
  id               String           @id @default(cuid())
  projectId        String?          @map("project_id")
  date             DateTime         @db.Date
  time             String?
  location         String?
  description      String
  severity         AccidentSeverity
  lostDays         Int              @default(0) @map("lost_days")
  rootCause        String?          @map("root_cause")
  correctiveAction String?          @map("corrective_action")
  reportedToSGK    Boolean          @default(false) @map("reported_to_sgk")
  status           AccidentStatus   @default(OPEN_ACCIDENT)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  involvedEmployees WorkAccidentEmployee[]

  @@map("work_accidents")
}

model WorkAccidentEmployee {
  id           String @id @default(cuid())
  accidentId   String @map("accident_id")
  employeeId   String @map("employee_id")
  injuryType   String? @map("injury_type")
  injuryPart   String? @map("injury_part")

  accident     WorkAccident @relation(fields: [accidentId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("work_accident_employees")
}

enum AccidentSeverity {
  NEAR_MISS
  MINOR
  MODERATE
  SERIOUS
  FATAL
}

enum AccidentStatus {
  OPEN_ACCIDENT
  INVESTIGATING
  CLOSED_ACCIDENT
}

// ─── ANA FİRMA PROFİLİ (singleton) ──────────────────────
model CompanyProfile {
  id            String   @id @default(cuid())
  name          String
  taxNo         String?  @map("tax_no")
  taxOffice     String?  @map("tax_office")
  address       String?
  phone         String?
  email         String?
  website       String?
  sector        String?
  foundedYear   Int?     @map("founded_year")
  logoUrl       String?  @map("logo_url")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

// ─── CRM: MÜŞTERİLER ────────────────────────────────────
model Customer {
  id            String         @id @default(cuid())
  name          String                              // Firma / Kişi adı
  type          CustomerType   @default(COMPANY)
  segment       CustomerSegment @default(PRIVATE)
  taxNo         String?        @map("tax_no")
  taxOffice     String?        @map("tax_office")
  address       String?
  city          String?
  phone         String?
  email         String?
  website       String?
  notes         String?
  status        CustomerStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  contacts      CustomerContact[]
  opportunities Opportunity[]
  communications CommunicationLog[]
  projects      Project[]

  @@map("customers")
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
  GOVERNMENT
}

enum CustomerSegment {
  PRIVATE
  PUBLIC
  CORPORATE
  SME
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

// ─── CRM: MÜŞTERİ İLETİŞİM KİŞİLERİ ───────────────────
model CustomerContact {
  id         String  @id @default(cuid())
  customerId String  @map("customer_id")
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  title      String?                          // Pozisyon/Ünvan
  phone      String?
  email      String?
  isPrimary  Boolean @default(false) @map("is_primary")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

// ─── CRM: FIRSATLAR (PIPELINE) ───────────────────────────
model Opportunity {
  id             String            @id @default(cuid())
  customerId     String            @map("customer_id")
  title          String
  description    String?
  stage          OpportunityStage  @default(LEAD)
  estimatedValue Decimal?          @map("estimated_value") @db.Decimal(15, 2)
  probability    Int               @default(0)            // Kazanma olasılığı %
  expectedClose  DateTime?         @map("expected_close")
  source         String?                                  // Nereden geldi (referans, ihale, vb.)
  assignedTo     String?           @map("assigned_to")    // Sorumlu kişi
  lostReason     String?           @map("lost_reason")
  wonDate        DateTime?         @map("won_date")
  lostDate       DateTime?        @map("lost_date")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  communications CommunicationLog[]

  @@map("opportunities")
}

enum OpportunityStage {
  LEAD            // İlk Temas
  NEEDS_ANALYSIS  // İhtiyaç Analizi
  PROPOSAL_SENT   // Teklif Gönderildi
  NEGOTIATION     // Müzakere
  WON             // Kazanıldı
  LOST            // Kaybedildi
}

// ─── CRM: İLETİŞİM GEÇMİŞİ ─────────────────────────────
model CommunicationLog {
  id             String              @id @default(cuid())
  customerId     String              @map("customer_id")
  opportunityId  String?             @map("opportunity_id")
  type           CommunicationType
  subject        String
  content        String?
  contactDate    DateTime            @default(now()) @map("contact_date")
  nextFollowUp   DateTime?           @map("next_follow_up")
  createdBy      String?             @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")

  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@map("communication_logs")
}

enum CommunicationType {
  MEETING
  PHONE
  EMAIL
  VISIT
  NOTE
}

// ─── DUYURULAR ───────────────────────────────────────────

model AnnouncementCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#3B82F6")  // tailwind blue-500
  icon        String?  // lucide icon adı
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  announcements Announcement[]

  @@map("announcement_categories")
}

model Announcement {
  id           String    @id @default(cuid())
  title        String
  content      String
  categoryId   String    @map("category_id")
  priority     AnnouncementPriority @default(NORMAL)
  isPinned     Boolean   @default(false) @map("is_pinned")
  targetType   AnnouncementTarget   @default(EVERYONE)
  targetRoles  String[]  @default([]) @map("target_roles")  // hedef roller (ADMIN, USER, vb.)
  authorId     String    @map("author_id")
  publishDate  DateTime  @default(now()) @map("publish_date")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  category     AnnouncementCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads        AnnouncementRead[]

  @@index([publishDate])
  @@index([categoryId])
  @@map("announcements")
}

model AnnouncementRead {
  id              String   @id @default(cuid())
  announcementId  String   @map("announcement_id")
  userId          String   @map("user_id")
  readAt          DateTime @default(now()) @map("read_at")

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementTarget {
  EVERYONE
  ROLE_BASED
  SPECIFIC_USERS
}

// ─── GERİ SAYIM SAYACI ────────────────────────────────────
model CountdownTimer {
  id          String   @id @default(cuid())
  title       String   @default("Haftalık Hedef")
  description String?  @db.Text
  targetDate  DateTime @map("target_date")
  emoji       String   @default("🏗️")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("countdown_timers")
}
