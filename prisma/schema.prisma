generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── KULLANICI ───────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  comments      ActivityComment[]
  announcements       Announcement[]
  announcementReads   AnnouncementRead[]
  countdownTimers     CountdownTimer[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

// ─── PROJELER ────────────────────────────────────────────
model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  customerId  String?       @map("customer_id")
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  zones       Zone[]
  floors      Floor[]
  activities  Activity[]
  risks       Risk[]
  workforce   WorkforceDaily[]
  materials   MaterialItem[]
  hakedisler  Hakedis[]
  hakedisContracts HakedisContract[]
  employees   Employee[]
  accidents   WorkAccident[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

// ─── MAHALLER (ZONE / ALAN) ──────────────────────────────
model Zone {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors      Floor[]
  activities  Activity[]
  materials   MaterialItem[]

  @@map("zones")
}

// ─── KATLAR ──────────────────────────────────────────────
model Floor {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  zoneId    String   @map("zone_id")
  name      String
  orderNo   Int      @default(0) @map("order_no")
  createdAt DateTime @default(now()) @map("created_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  activities Activity[]
  materials  MaterialItem[]

  @@map("floors")
}

// ─── DİSİPLİNLER ────────────────────────────────────────
model Discipline {
  id   String @id @default(cuid())
  name String @unique

  activities Activity[]
  teams      Team[]

  @@map("disciplines")
}

// ─── AKTİVİTELER (ANA TABLO) ────────────────────────────
model Activity {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  zoneId          String   @map("zone_id")
  floorId         String   @map("floor_id")
  disciplineId    String   @map("discipline_id")

  orderNo         Int      @default(0) @map("order_no")

  name            String
  weight          Float    @default(0)
  progressPercent Float    @default(0) @map("progress_percent")

  plannedStart    DateTime?  @map("planned_start")
  plannedFinish   DateTime?  @map("planned_finish")
  forecastFinish  DateTime?  @map("forecast_finish")
  actualFinish    DateTime?  @map("actual_finish")

  isCritical      Boolean  @default(false) @map("is_critical")
  status          ActivityStatus @default(NOT_STARTED)
  notes           String?

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  floor      Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  approvals  Approval[]
  risks      Risk[]
  comments   ActivityComment[]

  @@map("activities")
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  ON_HOLD
}

// ─── ONAYLAR ─────────────────────────────────────────────
model Approval {
  id          String         @id @default(cuid())
  activityId  String         @map("activity_id")
  title       String
  waitingOn   String?        @map("waiting_on")
  waitingDays Int            @default(0) @map("waiting_days")
  impactType  ImpactType     @default(DURATION) @map("impact_type")
  note        String?
  status      ApprovalStatus @default(WAITING)
  createdAt   DateTime       @default(now()) @map("created_at")

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

enum ApprovalStatus {
  WAITING
  RESOLVED
}

enum ImpactType {
  DURATION
  COST
  BOTH
}

// ─── RİSKLER ─────────────────────────────────────────────
model Risk {
  id          String     @id @default(cuid())
  projectId   String     @map("project_id")
  activityId  String?    @map("activity_id")

  title       String
  impact      Int        @default(1)
  probability Int        @default(1)
  score       Int        @default(1)
  action      String?
  responsible String?
  status      RiskStatus @default(OPEN)
  createdAt   DateTime   @default(now()) @map("created_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@map("risks")
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

// ─── AKTİVİTE YORUMLARI ─────────────────────────────────
model ActivityComment {
  id         String   @id @default(cuid())
  activityId String   @map("activity_id")
  text       String
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [createdBy], references: [id])

  @@map("activity_comments")
}

// ─── ŞİRKETLER ───────────────────────────────────────────
model Company {
  id        String      @id @default(cuid())
  name      String
  type      CompanyType @default(SUBCONTRACTOR)
  sortOrder Int         @default(0) @map("sort_order")

  teams Team[]
  hakedisler Hakedis[]
  hakedisContracts HakedisContract[]
  employees  Employee[]

  @@map("companies")
}

enum CompanyType {
  SUBCONTRACTOR
  MAIN
  MANAGEMENT
}

// ─── EKİPLER ─────────────────────────────────────────────
model Team {
  id           String @id @default(cuid())
  companyId    String @map("company_id")
  name         String
  disciplineId String @map("discipline_id")
  sortOrder    Int    @default(0) @map("sort_order")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  workforce  WorkforceDaily[]
  workers    Worker[]
  employees  Employee[]

  @@map("teams")
}

// ─── ÇALIŞANLAR ──────────────────────────────────────────
model Worker {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      String                          // Görevi (Kalıpçı, Formen, Elektrikçi vb.)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("workers")
}

// ─── PUANTAJ (GÜNLÜK YOKLAMA) ────────────────────────────
model Attendance {
  id         String           @id @default(cuid())
  workerId   String           @map("worker_id")
  date       DateTime         @db.Date
  shift      ShiftType        @default(DAY)                    // Vardiya
  status     AttendanceStatus @default(ABSENT)
  totalHours Float            @default(0) @map("total_hours")   // Toplam çalışma saati
  overtime   Float            @default(0)                       // Mesai saati
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  worker     Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date, shift])
  @@map("attendances")
}

enum ShiftType {
  DAY        // Gündüz
  NIGHT      // Gece
}

enum AttendanceStatus {
  PRESENT       // Geldi
  HALF_DAY      // Yarım gün
  ABSENT        // Gelmedi (mazeretsiz)
  PAID_LEAVE    // Ücretli izin
  UNPAID_LEAVE  // Ücretsiz izin
  ANNUAL_LEAVE  // Yıllık izin
  SICK_LEAVE    // Raporlu
  DAY_OFF       // Hafta tatili
}

// ─── MALZEME TAKİP ───────────────────────────────────────
model MaterialItem {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  zoneId           String   @map("zone_id")
  floorId          String   @map("floor_id")

  pozNo            String   @map("poz_no")
  orderPriority    Int      @default(0) @map("order_priority")
  scope            String                                      // İşin kapsamı
  unit             String                                      // Birim (m², adet, kg…)
  quantity         Float    @default(0)                        // Sipariş miktarı (kat bazlı)

  // Tasarım ve Malzeme Onay Süreci
  designApproval   MaterialApprovalStatus @default(BEKLEMEDE) @map("design_approval")
  ownerApproval    MaterialApprovalStatus @default(BEKLEMEDE) @map("owner_approval")
  approvalNote     String?  @map("approval_note")              // Durum / Karar (onay)

  // Malzeme Sipariş Süreci
  quotationFirms   String?  @map("quotation_firms")            // Teklif firmaları (metin)
  orderDecision    String?  @map("order_decision")             // Durum / Karar (sipariş)

  // Ürün Siparişi ve Teslimi
  supplierName     String?  @map("supplier_name")
  supplierContact  String?  @map("supplier_contact")
  orderStatus      MaterialOrderStatus    @default(BEKLEMEDE)  @map("order_status")
  deliveryStatus   MaterialDeliveryStatus @default(BEKLEMEDE)  @map("delivery_status")
  responsiblePerson String? @map("responsible_person")

  note             String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt     @map("updated_at")

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zone             Zone     @relation(fields: [zoneId],    references: [id], onDelete: Cascade)
  floor            Floor    @relation(fields: [floorId],   references: [id], onDelete: Cascade)

  @@map("material_items")
}

enum MaterialApprovalStatus {
  BEKLEMEDE
  ONAYLANDI
  REDDEDILDI
  REVIZE
}

enum MaterialOrderStatus {
  BEKLEMEDE
  SIPARIS_VERILDI
  URETIMDE
  HAZIRLANDI
  IPTAL
}

enum MaterialDeliveryStatus {
  BEKLEMEDE
  YOLDA
  TESLIM_EDILDI
  EKSIK_TESLIM
  IPTAL
}

// ─── GÜNLÜK PERSONEL ─────────────────────────────────────
model WorkforceDaily {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  date        DateTime @db.Date
  teamId      String   @map("team_id")
  workerCount Int      @default(0) @map("worker_count")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, teamId])
  @@map("workforce_daily")
}

// ─── SÖZLEŞME / KEŞİF (HAKEDİŞ MODÜLÜ) ─────────────────
model HakedisContract {
  id              String              @id @default(cuid())
  projectId       String              @map("project_id")
  companyId       String?             @map("company_id")
  type            HakedisType                                  // ISVEREN veya TASERON
  name            String                                       // Sözleşme adı
  currency        String              @default("TRY")          // Para birimi (TRY, USD, EUR, GBP)
  pricingModel    PricingModel        @default(AYRINTILI) @map("pricing_model") // Fiyatlandırma modeli
  contractNo      String?             @map("contract_no")      // Sözleşme numarası
  contractDate    DateTime?           @map("contract_date")
  totalAmount     Float               @default(0) @map("total_amount")
  advanceRate     Float               @default(0) @map("advance_rate")     // Avans oranı %
  retentionRate   Float               @default(0) @map("retention_rate")   // Teminat kesintisi %
  description     String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company         Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  items           HakedisContractItem[]
  atasmanlar      Atasman[]
  hakedisler      Hakedis[]
  ihzaratlar      Ihzarat[]

  @@map("hakedis_contracts")
}

// ─── KEŞİF KALEMLERİ (POZ LİSTESİ) ──────────────────────
model HakedisContractItem {
  id              String           @id @default(cuid())
  contractId      String           @map("contract_id")

  // Gruplama
  anaGrup         String?          @map("ana_grup")             // ELEKTRİK TESİSATI, YAPI İŞLERİ, SU TESİSATI...
  altGrup         String?          @map("alt_grup")             // Aydınlatma Sistemleri, Beton İşleri...
  isKalemiGrubu   String?          @map("is_kalemi_grubu")      // LED Armatürler, Hazır Beton...

  // Poz bilgileri
  pozNo           String           @map("poz_no")
  description     String                                        // Açıklama
  unit            String                                        // Birim (adet, mt, m³, kg)
  quantity        Float            @default(0)                  // Sözleşme Miktar
  marka           String?                                       // Marka
  sartname        String?                                       // Şartname/Spec  

  // Fiyatlar (ayrı ayrı)
  malzemeFiyati   Float            @default(0) @map("malzeme_fiyati")
  iscilikFiyati   Float            @default(0) @map("iscilik_fiyati")
  ggkFiyati       Float            @default(0) @map("ggk_fiyati")
  toplamBirimFiyat Float           @default(0) @map("toplam_birim_fiyat")
  toplamTutar     Float            @default(0) @map("toplam_tutar")

  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  contract        HakedisContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  atasmanKalemleri AtasmanKalemi[]
  ihzaratKalemleri IhzaratKalemi[]

  @@map("hakedis_contract_items")
}

// ─── ATAŞMAN (Saha Ölçümleri) ────────────────────────────
model Atasman {
  id              String           @id @default(cuid())
  contractId      String           @map("contract_id")
  hakedisId       String?          @map("hakedis_id")
  atasmanNo       String           @map("atasman_no")           // ATŞ-001, ATŞ-002...
  aciklama        String?                                       // Ataşman açıklaması
  katBolge        String?          @map("kat_bolge")            // Kat/Bölge bilgisi
  tarih           DateTime?        @db.Date                     // Ölçüm tarihi
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  contract        HakedisContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  hakedis         Hakedis?         @relation(fields: [hakedisId], references: [id], onDelete: SetNull)
  kalemler        AtasmanKalemi[]

  @@map("atasmanlar")
}

// ─── ATAŞMAN KALEMLERİ ──────────────────────────────────
model AtasmanKalemi {
  id              String              @id @default(cuid())
  atasmanId       String              @map("atasman_id")
  kesifKalemiId   String              @map("kesif_kalemi_id")   // HakedisContractItem referansı
  miktar          Float               @default(0)               // Sahada ölçülen miktar
  aciklama        String?                                        // Ek açıklama
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  atasman         Atasman             @relation(fields: [atasmanId], references: [id], onDelete: Cascade)
  kesifKalemi     HakedisContractItem @relation(fields: [kesifKalemiId], references: [id], onDelete: Cascade)

  @@map("atasman_kalemleri")
}

// ─── HAKEDİŞ ─────────────────────────────────────────────
model Hakedis {
  id                String        @id @default(cuid())
  projectId         String        @map("project_id")
  companyId         String?       @map("company_id")
  contractId        String?       @map("contract_id")
  type              HakedisType
  no                Int                                        // Hakediş no (sıralı)
  period            String                                     // "Ocak 2026"
  startDate         DateTime?     @map("start_date")
  endDate           DateTime?     @map("end_date")

  // Tutarlar
  totalAmount       Float         @default(0) @map("total_amount")
  previousAmount    Float         @default(0) @map("previous_amount")
  currentAmount     Float         @default(0) @map("current_amount")

  // Kesintiler
  advanceDeduction  Float         @default(0) @map("advance_deduction")
  retentionRate     Float         @default(0) @map("retention_rate")
  retentionAmount   Float         @default(0) @map("retention_amount")
  stampTax          Float         @default(0) @map("stamp_tax")
  otherDeduction    Float         @default(0) @map("other_deduction")

  netAmount         Float         @default(0) @map("net_amount")
  status            HakedisStatus @default(DRAFT)
  notes             String?

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contract          HakedisContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  atasmanlar        Atasman[]
  ihzaratlar        Ihzarat[]

  @@map("hakedis")
}

enum HakedisType {
  ISVEREN
  TASERON
}

enum PricingModel {
  AYRINTILI    // Malzeme + İşçilik + GGK ayrıntılı
  TEKFIYAT     // Tek birim fiyat
}

enum HakedisStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

// ─── İHZARAT (Malzeme Ön Ödemesi) ───────────────────────
model Ihzarat {
  id              String              @id @default(cuid())
  contractId      String              @map("contract_id")
  hakedisId       String              @map("hakedis_id")
  ihzaratNo       String              @map("ihzarat_no")           // İHZ-001, İHZ-002...
  aciklama        String?                                           // İhzarat açıklaması
  tarih           DateTime?           @db.Date                     // İhzarat tarihi
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  contract        HakedisContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  hakedis         Hakedis             @relation(fields: [hakedisId], references: [id], onDelete: Cascade)
  kalemler        IhzaratKalemi[]

  @@map("ihzaratlar")
}

// ─── İHZARAT KALEMLERİ ──────────────────────────────────
model IhzaratKalemi {
  id              String              @id @default(cuid())
  ihzaratId       String              @map("ihzarat_id")
  kesifKalemiId   String              @map("kesif_kalemi_id")      // HakedisContractItem referansı
  miktar          Float               @default(0)                  // İhzarat miktarı (sahada stokta olan malzeme)
  aciklama        String?                                           // Ek açıklama
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  ihzarat         Ihzarat             @relation(fields: [ihzaratId], references: [id], onDelete: Cascade)
  kesifKalemi     HakedisContractItem @relation(fields: [kesifKalemiId], references: [id], onDelete: Cascade)

  @@map("ihzarat_kalemleri")
}

// ═══════════════════════════════════════════════════════════
// İK + İSG ORTAK TABAN
// ═══════════════════════════════════════════════════════════

// ─── DEPARTMANLAR ────────────────────────────────────────
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]
  positions Position[]

  @@map("departments")
}

// ─── POZİSYONLAR ────────────────────────────────────────
model Position {
  id           String   @id @default(cuid())
  departmentId String   @map("department_id")
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@map("positions")
}

// ─── ÇALIŞANLAR (ORTAK TABAN) ────────────────────────────
model Employee {
  id                String   @id @default(cuid())

  // Kişisel Bilgiler
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  tcNo              String?  @unique @map("tc_no")
  birthDate         DateTime? @map("birth_date") @db.Date
  birthPlace        String?  @map("birth_place")
  gender            Gender?
  maritalStatus     MaritalStatus? @map("marital_status")
  bloodType         BloodType? @map("blood_type")
  phone             String?
  email             String?
  address           String?

  // Acil Durum
  emergencyName     String?  @map("emergency_name")
  emergencyPhone    String?  @map("emergency_phone")
  emergencyRelation String?  @map("emergency_relation")

  // Organizasyon
  companyId         String?  @map("company_id")
  departmentId      String?  @map("department_id")
  positionId        String?  @map("position_id")
  projectId         String?  @map("project_id")
  teamId            String?  @map("team_id")
  managerId         String?  @map("manager_id")

  // İş Bilgileri
  employeeNo        String?  @unique @map("employee_no")
  hireDate          DateTime? @map("hire_date") @db.Date
  sgkStartDate      DateTime? @map("sgk_start_date") @db.Date
  sgkNo             String?  @map("sgk_no")

  // Maaş
  salary            Float?   @default(0)
  salaryType        SalaryType? @map("salary_type")

  // Durum
  status            EmployeeStatus @default(ACTIVE)
  exitDate          DateTime? @map("exit_date") @db.Date
  exitReason        ExitReason? @map("exit_reason")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Organizasyon İlişkileri
  company           Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position          Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  project           Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team              Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  manager           Employee?   @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates      Employee[]  @relation("ManagerSubordinates")

  // İK İlişkileri
  contracts         Contract[]
  documents         EmployeeDocument[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  disciplineRecords DisciplineRecord[]
  performanceReviews PerformanceReview[]
  positionHistory   PositionHistory[]

  // İSG İlişkileri
  trainings         EmployeeTraining[]
  certificates      Certificate[]
  medicalExams      MedicalExam[]
  ppeAssignments    PPEAssignment[]
  accidents         WorkAccidentEmployee[]

  @@map("employees")
}

enum Gender {
