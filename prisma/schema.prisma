  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum EmployeeStatus {
  ACTIVE
  PASSIVE
  ON_LEAVE
  SUSPENDED
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

enum ExitReason {
  RESIGNATION
  TERMINATION
  MUTUAL
  RETIREMENT
  CONTRACT_END
  OTHER
}

// ═══════════════════════════════════════════════════════════
